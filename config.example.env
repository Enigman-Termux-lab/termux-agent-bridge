# ==============================================================================
# 🚀 Termux Agent Gateway — Шаблон конфигурации (~/.termux_agent_gateway.env)
# ==============================================================================
# Скопируйте этот файл в домашнюю директорию в Termux:
#   cp config.example.env ~/.termux_agent_gateway.env
#   chmod 600 ~/.termux_agent_gateway.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Профиль безопасности (Security Profile)
# ------------------------------------------------------------------------------
# Доступные режимы:
#   monitor     - 🟢 Риск 0/5. Только чтение: system_status, battery_info, tail_log.
#                 Bash и запись файлов полностью отсутствуют в схеме инструментов MCP.
#
#   workspace   - 🟡 Риск 2/5. Песочница: workspace_bash, file_read, file_write.
#                 Команды и файлы строго ограничены каталогом WORKSPACE_DIR.
#                 Запрещен переход через '..', запрещены pkg, sudo, chroot, /data.
#
#   interactive - 🟠 Риск 1.5/5 (РЕКОМЕНДУЕТСЯ ПО УМОЛЧАНИЮ).
#                 Безопасные команды (ls, cat, git status) исполняются сразу.
#                 Опасные команды (rm, mv, pkg, kill, curl, chmod) ставятся на паузу
#                 и отправляют push-уведомление в Android (termux-notification)
#                 с кнопками «Разрешить» и «Заблокировать».
#
#   godmode     - 🔴 Риск 5/5. Полный неограниченный доступ (bash_run, antigravity_run,
#                 termux_api). Использовать только в доверенных сессиях!
#
GATEWAY_MODE="interactive"

# ------------------------------------------------------------------------------
# 2. Сетевые параметры и статический домен Ngrok
# ------------------------------------------------------------------------------
# Локальный порт шлюза (по умолчанию 8000)
BRIDGE_PORT=8000

# Ваш статический бесплатный или платный домен ngrok
NGROK_DOMAIN="unstaffed-clamshell-overplant.ngrok-free.dev"

# ------------------------------------------------------------------------------
# 3. Секретный Capability URL (Секретный путь)
# ------------------------------------------------------------------------------
# Длинная случайная строка в URL вместо логина и пароля (Bearer token).
# Итоговый адрес для подключения агентов:
#   https://${NGROK_DOMAIN}/${SECRET_PATH}/sse
#
# ВАЖНО: Никому не передавайте и не публикуйте в открытых чатах полный адрес!
SECRET_PATH="spark-7e4a19b8c0d3e5f2a1b4c6d8"

# Старый секретный путь для плавной обратной совместимости.
# Позволяет старым клиентам продолжать работать до обновления их конфигурации.
OLD_SECRET_PATH="spark-693cff05cc2e0b79420ffe3d"

# ------------------------------------------------------------------------------
# 4. Настройки песочницы WORKSPACE
# ------------------------------------------------------------------------------
# Каталог, за пределы которого агент не сможет выйти в режиме workspace.
WORKSPACE_DIR="$HOME/workspace"

# ------------------------------------------------------------------------------
# 5. Интерактивное подтверждение в Android (INTERACTIVE)
# ------------------------------------------------------------------------------
# Время ожидания клика пользователя по кнопке в уведомлении (в секундах).
# Если за это время пользователь не нажал «Разрешить», команда отклоняется.
APPROVAL_TIMEOUT=45
